{
  "name": "@xlsama/md",
  "version": "0.1.1",
  "description": "Edit local Markdown in your browser: one `md` command, live sync with AI-agent edits, auto-format on save. 浏览器里的本地 Markdown 编辑器。",
  "type": "module",
  "license": "MIT",
  "author": "xlsama",
  "homepage": "https://github.com/xlsama/md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xlsama/md.git"
  },
  "bugs": "https://github.com/xlsama/md/issues",
  "keywords": [
    "markdown",
    "editor",
    "browser",
    "wysiwyg",
    "bun",
    "meowdown",
    "autocorrect",
    "oxfmt"
  ],
  "bin": {
    "md": "./npm/md.cjs"
  },
  "files": [
    "npm",
    "src"
  ],
  "exports": {
    ".": "./src/daemon.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/cli.ts daemon",
    "start": "bun run src/cli.ts daemon",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:binary": "bun run scripts/build-binary.ts",
    "pack:npm": "bun run scripts/pack-npm.ts",
    "inject:optional-deps": "bun run scripts/inject-optional-deps.ts",
    "prepublishOnly": "cp ../../README.md ../../LICENSE ."
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "autocorrect-node": "^2.14.0",
    "hono": "^4.13.1",
    "oxfmt": "^0.63.0",
    "trash": "^10.1.1",
    "zod": "^4.4.3"
  }
}

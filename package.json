{
  "name": "md-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter @md/web build",
    "start": "pnpm --filter writedown start",
    "test": "pnpm -r test",
    "lint": "oxlint --fix",
    "release": "bumpp -r",
    "publish": "pnpm --filter writedown publish --access public",
    "publish:dry-run": "pnpm --filter writedown publish --access public --dry-run"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "bumpp": "^12.2.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
